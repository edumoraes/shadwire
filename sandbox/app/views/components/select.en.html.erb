<% content_for :title, "Select — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Select</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Shows a list of options for the user to choose from — triggered by a button.
    </p>
  </header>

  <%= render "components/install", name: "select" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      O controller <code class="rounded bg-muted px-1 py-0.5 text-xs">ui-select</code>
      follows the APG <em>select-only combobox</em> pattern: focus stays on the trigger
      (<code class="rounded bg-muted px-1 py-0.5 text-xs">role="combobox"</code>) and the active option
      is announced through <code class="rounded bg-muted px-1 py-0.5 text-xs">aria-activedescendant</code>.
      Selecting updates a hidden <code class="rounded bg-muted px-1 py-0.5 text-xs">input</code> and fires
      <code class="rounded bg-muted px-1 py-0.5 text-xs">change</code>.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Or render the components directly:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <%= docs_code_block(@composition) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      Every part accepts <code class="rounded bg-muted px-1 py-0.5 text-xs">class</code> /
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class_name</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">**attrs</code>.
    </p>
    <%= render layout: "docs/table", locals: { headers: [ t("components.api.component"), t("components.api.argument"), t("components.api.default"), t("components.api.description") ] } do %>
      <tr>
        <td><code>Select</code></td>
        <td><code>name</code></td>
        <td><code>nil</code></td>
        <td>The hidden input's name, for form submission.</td>
      </tr>
      <tr>
        <td><code>Select</code></td>
        <td><code>value</code></td>
        <td><code>nil</code></td>
        <td>The value selected at first.</td>
      </tr>
      <tr>
        <td><code>Select</code></td>
        <td><code>placeholder</code></td>
        <td><code>nil</code></td>
        <td>The text shown when nothing is selected.</td>
      </tr>
      <tr>
        <td><code>Select::Trigger</code></td>
        <td><code>size</code></td>
        <td><code>:default</code></td>
        <td><code>:default</code> or <code>:sm</code>.</td>
      </tr>
      <tr>
        <td><code>Select::Item</code></td>
        <td><code>value:</code> (required), <code>disabled</code></td>
        <td>—</td>
        <td>The option's value; disabled items are skipped during navigation.</td>
      </tr>
    <% end %>
  </section>
</article>
