<%# Install section for a component documentation page.
    Everything here is derived from registry/registry.json at render time, so the
    documented file list can never drift from what the registry installs.
    Renders nothing when the page has no matching registry item. %>
<% if registry_item(name) %>
<section class="flex flex-col gap-4">
  <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.installation") %></h2>

  <p class="text-sm text-muted-foreground">
    <%= t("components.install.lead_html") %>
  </p>

  <%= docs_code_block("#{registry_install_command(name)} --yes", language: :shell) %>

  <% targets = registry_install_targets(name) %>
  <% if targets.any? %>
    <p class="text-sm text-muted-foreground">
      <%= t("components.install.files_html", name: docs_code_sm(name)) %>
    </p>

    <ul class="flex flex-col gap-1 text-sm">
      <% targets.each do |path| %>
        <li class="flex items-center gap-2 text-muted-foreground">
          <%= ui_icon("file-code", size: :sm) %>
          <code><%= path %></code>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if registry_requires_stimulus?(name) %>
    <p class="text-sm text-muted-foreground">
      <%= t("components.install.stimulus_html",
             importmap: docs_code_sm("importmap-rails"),
             stimulus: docs_code_sm("stimulus-rails")) %>
    </p>
  <% end %>

  <p class="text-sm text-muted-foreground">
    <%= t("components.install.cli_html",
           install: docs_code_sm("gem install shadwire"),
           init: docs_code_sm("shadwire init")) %>
  </p>
</section>
<% end %>
