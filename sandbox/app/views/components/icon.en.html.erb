<% content_for :title, "Icon — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Icon</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A wrapper around lucide-rails with shadcn sizes and accessible semantics.
    </p>
  </header>

  <%= render "components/install", name: "icon" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">Names use Lucide's kebab-case, such as <code class="rounded bg-muted px-1 py-0.5 text-xs">"chevron-down"</code>.</p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Or render <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::IconComponent</code> directly:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground"><code class="rounded bg-muted px-1 py-0.5 text-xs">ui_icon(name, **options)</code> wraps <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::IconComponent.new(name, **options)</code>.</p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50"><tr><th><%= t("components.api.argument") %></th><th><%= t("components.api.type") %></th><th><%= t("components.api.default") %></th><th><%= t("components.api.description") %></th></tr></thead>
        <tbody>
          <tr><td><code>name</code></td><td>String</td><td>Required</td><td>The Lucide icon name, in kebab-case.</td></tr>
          <tr><td><code>size</code></td><td>Symbol/String</td><td><code>:default</code></td><td><code>:sm</code>, <code>:default</code>, <code>:lg</code> ou <code>:xl</code>.</td></tr>
          <tr><td><code>label</code></td><td>String</td><td><code>nil</code></td><td>When present, exposes the SVG with <code>role="img"</code> and <code>aria-label</code>.</td></tr>
          <tr><td><code>**attrs</code></td><td>Hash</td><td><code>{}</code></td><td>Free-form HTML attributes for the SVG.</td></tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
