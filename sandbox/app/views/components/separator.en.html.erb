<% content_for :title, "Separator — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Separator</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Divides content, visually or semantically.
    </p>
  </header>

  <%= render "components/install", name: "separator" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">Use the semantic mode by default. Pass <code class="rounded bg-muted px-1 py-0.5 text-xs">decorative: true</code> for purely visual dividers.</p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Or render <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::SeparatorComponent</code> directly:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground"><code class="rounded bg-muted px-1 py-0.5 text-xs">ui_separator(**options)</code> wraps <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::SeparatorComponent.new(**options)</code>.</p>
    <%= render layout: "docs/table", locals: { headers: [ t("components.api.argument"), t("components.api.type"), t("components.api.default"), t("components.api.description") ] } do %>
      <tr><td><code>orientation</code></td><td>Symbol/String</td><td><code>:horizontal</code></td><td><code>:horizontal</code> or <code>:vertical</code>.</td></tr>
      <tr><td><code>decorative</code></td><td>Boolean</td><td><code>nil</code></td><td>When <code>true</code>, renders <code>role="none"</code> and <code>aria-hidden="true"</code>.</td></tr>
      <tr><td><code>**attrs</code></td><td>Hash</td><td><code>{}</code></td><td>Free-form HTML attributes, merging <code>data</code>/<code>aria</code>.</td></tr>
    <% end %>
  </section>
</article>
