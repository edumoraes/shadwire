<% content_for :title, "Textarea — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Textarea</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Exibe uma área de texto ou um componente que se parece com uma área de texto.
    </p>
  </header>

  <%= render "components/install", name: "textarea" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Uso</h2>
    <p class="text-sm text-muted-foreground">
      Use o helper <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_textarea</code>
      em qualquer view. O bloco vira o valor inicial da área de texto.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Ou renderize o componente
      <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::TextareaComponent</code>
      diretamente:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Exemplos</h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Referência da API</h2>
    <p class="text-sm text-muted-foreground">
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_textarea(**options, &block)</code>
      encapsula
      <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::TextareaComponent.new(**options)</code>.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th>Argumento</th>
            <th>Tipo</th>
            <th>Padrão</th>
            <th>Descrição</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>class</code> / <code>class_name</code></td>
            <td>String</td>
            <td><code>nil</code></td>
            <td>Classes extras, mescladas após as classes base.</td>
          </tr>
          <tr>
            <td><code>**attrs</code></td>
            <td>Hash</td>
            <td><code>{}</code></td>
            <td>Atributos HTML livres (<code>name</code>, <code>rows</code>, <code>placeholder</code>, <code>disabled</code>, <code>data:</code>, <code>aria:</code>, …).</td>
          </tr>
          <tr>
            <td><code>&block</code></td>
            <td>Block</td>
            <td>—</td>
            <td>Valor inicial da área de texto.</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
