<% content_for :title, "Table — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Table</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A responsive table built on the native semantic elements.
    </p>
  </header>

  <%= render "components/install", name: "table" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      Each part renders its matching HTML element
      (<code class="rounded bg-muted px-1 py-0.5 text-xs">thead</code>,
      <code class="rounded bg-muted px-1 py-0.5 text-xs">tbody</code>,
      <code class="rounded bg-muted px-1 py-0.5 text-xs">th</code>, …) — use
      <code class="rounded bg-muted px-1 py-0.5 text-xs">scope:</code> on the headers
      e <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_table_caption</code>
      to describe the table.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Or render the components directly:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <p class="text-sm text-muted-foreground">
      The root wraps the table in a horizontally scrolling container.
    </p>
    <%= docs_code_block(@composition) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      Every part accepts <code class="rounded bg-muted px-1 py-0.5 text-xs">class</code> /
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class_name</code>,
      <code class="rounded bg-muted px-1 py-0.5 text-xs">**attrs</code> e bloco.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th>Helper</th>
            <th><%= t("components.api.element") %></th>
            <th>Notas</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>ui_table</code></td>
            <td><code>div &gt; table</code></td>
            <td>The container, with <code>overflow-x-auto</code>; extra classes land on the <code>&lt;table&gt;</code>.</td>
          </tr>
          <tr>
            <td><code>ui_table_header</code> / <code>ui_table_body</code> / <code>ui_table_footer</code></td>
            <td><code>thead</code> / <code>tbody</code> / <code>tfoot</code></td>
            <td>The table's sections.</td>
          </tr>
          <tr>
            <td><code>ui_table_row</code></td>
            <td><code>tr</code></td>
            <td><code>data: { state: "selected" }</code> destaca a linha.</td>
          </tr>
          <tr>
            <td><code>ui_table_head</code></td>
            <td><code>th</code></td>
            <td>Pass <code>scope: "col"</code> or <code>scope: "row"</code>.</td>
          </tr>
          <tr>
            <td><code>ui_table_cell</code></td>
            <td><code>td</code></td>
            <td>Aceita <code>colspan</code>/<code>rowspan</code> via attrs.</td>
          </tr>
          <tr>
            <td><code>ui_table_caption</code></td>
            <td><code>caption</code></td>
            <td>An accessible description, shown below the table (<code>caption-bottom</code>).</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
