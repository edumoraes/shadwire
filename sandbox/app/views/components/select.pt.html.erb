<% content_for :title, "Select — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Select</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Exibe uma lista de opções para o usuário escolher — disparada por um botão.
    </p>
  </header>

  <%= render "components/install", name: "select" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      O controller <code class="rounded bg-muted px-1 py-0.5 text-xs">ui-select</code>
      segue o padrão <em>select-only combobox</em> da APG: o foco permanece no gatilho
      (<code class="rounded bg-muted px-1 py-0.5 text-xs">role="combobox"</code>) e a opção
      ativa é anunciada por <code class="rounded bg-muted px-1 py-0.5 text-xs">aria-activedescendant</code>.
      A seleção atualiza um <code class="rounded bg-muted px-1 py-0.5 text-xs">input</code> hidden e dispara
      <code class="rounded bg-muted px-1 py-0.5 text-xs">change</code>.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Ou renderize os componentes diretamente:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <%= docs_code_block(@composition) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      Todas as partes aceitam <code class="rounded bg-muted px-1 py-0.5 text-xs">class</code> /
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class_name</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">**attrs</code>.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th>Componente</th>
            <th><%= t("components.api.argument") %></th>
            <th><%= t("components.api.default") %></th>
            <th><%= t("components.api.description") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>Select</code></td>
            <td><code>name</code></td>
            <td><code>nil</code></td>
            <td>Nome do input hidden para submissão em formulários.</td>
          </tr>
          <tr>
            <td><code>Select</code></td>
            <td><code>value</code></td>
            <td><code>nil</code></td>
            <td>Valor inicialmente selecionado.</td>
          </tr>
          <tr>
            <td><code>Select</code></td>
            <td><code>placeholder</code></td>
            <td><code>nil</code></td>
            <td>Texto exibido quando nada está selecionado.</td>
          </tr>
          <tr>
            <td><code>Select::Trigger</code></td>
            <td><code>size</code></td>
            <td><code>:default</code></td>
            <td><code>:default</code> ou <code>:sm</code>.</td>
          </tr>
          <tr>
            <td><code>Select::Item</code></td>
            <td><code>value:</code> (obrigatório), <code>disabled</code></td>
            <td>—</td>
            <td>Valor da opção; itens desabilitados são pulados na navegação.</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
