<% content_for :title, "Avatar — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Avatar</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A circular user image with a text fallback.
    </p>
  </header>

  <%= render "components/install", name: "avatar" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Or render <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::AvatarComponent</code> directly:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground"><code class="rounded bg-muted px-1 py-0.5 text-xs">ui_avatar(**options, &block)</code> wraps <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::AvatarComponent.new(**options)</code>.</p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50"><tr><th><%= t("components.api.argument") %></th><th><%= t("components.api.type") %></th><th><%= t("components.api.default") %></th><th><%= t("components.api.description") %></th></tr></thead>
        <tbody>
          <tr><td><code>src</code></td><td>String</td><td><code>nil</code></td><td>URL da imagem.</td></tr>
          <tr><td><code>alt</code></td><td>String</td><td><code>""</code></td><td>Texto alternativo da imagem.</td></tr>
          <tr><td><code>fallback</code></td><td>String</td><td><code>nil</code></td><td>Initials or a symbol shown when there is no image.</td></tr>
          <tr><td><code>**attrs</code></td><td>Hash</td><td><code>{}</code></td><td>Free-form HTML attributes on the wrapper.</td></tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
