<% content_for :title, "Label — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Label</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Renders an accessible label tied to a form control.
    </p>
  </header>

  <%= render "components/install", name: "label" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      Use the <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_label</code> helper.
      Because <code class="rounded bg-muted px-1 py-0.5 text-xs">for</code> is a reserved word
      in Ruby, it travels as a free-form HTML attribute — always point it at the
      <code class="rounded bg-muted px-1 py-0.5 text-xs">id</code> do controle.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Or render the component
      <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::LabelComponent</code>
      diretamente:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_label(**options, &block)</code>
      encapsula
      <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::LabelComponent.new(**options)</code>.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th><%= t("components.api.argument") %></th>
            <th><%= t("components.api.type") %></th>
            <th><%= t("components.api.default") %></th>
            <th><%= t("components.api.description") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>class</code> / <code>class_name</code></td>
            <td>String</td>
            <td><code>nil</code></td>
            <td>Extra classes, merged after the base classes.</td>
          </tr>
          <tr>
            <td><code>**attrs</code></td>
            <td>Hash</td>
            <td><code>{}</code></td>
            <td>Atributos HTML livres (<code>for</code>, <code>id</code>, <code>data:</code>, <code>aria:</code>, …).</td>
          </tr>
          <tr>
            <td><code>&block</code></td>
            <td>Block</td>
            <td>—</td>
            <td>The label's content — text and/or icons.</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
