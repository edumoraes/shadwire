<% content_for :title, "Alert — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Alert</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A callout block with alert semantics, for messages that matter.
    </p>
  </header>

  <%= render "components/install", name: "alert" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Or render <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::AlertComponent</code> directly:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground"><code class="rounded bg-muted px-1 py-0.5 text-xs">ui_alert(**options, &block)</code> wraps <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::AlertComponent.new(**options)</code>.</p>
    <%= render layout: "docs/table", locals: { headers: [ t("components.api.argument"), t("components.api.type"), t("components.api.default"), t("components.api.description") ] } do %>
      <tr><td><code>variant</code></td><td>Symbol/String</td><td><code>:default</code></td><td><code>:default</code> or <code>:destructive</code>.</td></tr>
      <tr><td><code>role</code></td><td>String</td><td><code>"alert"</code></td><td>Override it when the message should not be announced immediately.</td></tr>
      <tr><td><code>**attrs</code></td><td>Hash</td><td><code>{}</code></td><td>Free-form HTML attributes.</td></tr>
    <% end %>
  </section>
</article>
