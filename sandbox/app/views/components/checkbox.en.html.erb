<% content_for :title, "Checkbox — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Checkbox</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A control for toggling between checked and unchecked, keeping the native input.
    </p>
  </header>

  <%= render "components/install", name: "checkbox" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      The component styles the native <code class="rounded bg-muted px-1 py-0.5 text-xs">&lt;input type="checkbox"&gt;</code>
      native input — semantics, focus and keyboard come from the browser. The check glyph comes from
      utility <code class="rounded bg-muted px-1 py-0.5 text-xs">.shadwire-checkbox</code>
      em <code class="rounded bg-muted px-1 py-0.5 text-xs">shadwire.css</code>.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Or render the component
      <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::CheckboxComponent</code>
      diretamente:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_checkbox(**options)</code>
      encapsula
      <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::CheckboxComponent.new(**options)</code>.
    </p>
    <%= render layout: "docs/table", locals: { headers: [ t("components.api.argument"), t("components.api.type"), t("components.api.default"), t("components.api.description") ] } do %>
      <tr>
        <td><code>checked</code></td>
        <td>Boolean</td>
        <td><code>false</code></td>
        <td>Renders the input checked.</td>
      </tr>
      <tr>
        <td><code>disabled</code></td>
        <td>Boolean</td>
        <td><code>false</code></td>
        <td>Disables the native input.</td>
      </tr>
      <tr>
        <td><code>class</code> / <code>class_name</code></td>
        <td>String</td>
        <td><code>nil</code></td>
        <td>Extra classes, merged after the base classes.</td>
      </tr>
      <tr>
        <td><code>**attrs</code></td>
        <td>Hash</td>
        <td><code>{}</code></td>
        <td>Atributos HTML livres (<code>name</code>, <code>id</code>, <code>value</code>, <code>data:</code>, <code>aria:</code>, …).</td>
      </tr>
    <% end %>
  </section>
</article>
