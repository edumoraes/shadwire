<% content_for :title, "Card — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Card</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A bordered surface for grouping related content.
    </p>
  </header>

  <%= render "components/install", name: "card" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Or render the components directly:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <%= docs_code_block(@composition, language: :text) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">Available helpers: <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_header</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_title</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_description</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_content</code> and <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_footer</code>.</p>
    <%= render layout: "docs/table", locals: { headers: [ "API", t("components.api.element"), t("components.api.description") ] } do %>
      <tr><td><code>ui_card</code></td><td><code>div</code></td><td>The container: border, card surface and shadow.</td></tr>
      <tr><td><code>ui_card_header</code></td><td><code>div</code></td><td>The top area, with vertical spacing.</td></tr>
      <tr><td><code>ui_card_title</code></td><td><code>h3</code></td><td>The title; accepts <code>tag_name:</code>.</td></tr>
      <tr><td><code>ui_card_description</code></td><td><code>p</code></td><td>Supporting text in muted foreground.</td></tr>
      <tr><td><code>ui_card_content</code></td><td><code>div</code></td><td>The main content.</td></tr>
      <tr><td><code>ui_card_footer</code></td><td><code>div</code></td><td>Bottom actions or metadata.</td></tr>
    <% end %>
  </section>
</article>
