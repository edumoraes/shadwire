<% content_for :title, "Sheet — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Sheet</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Estende o Dialog para exibir conteúdo complementar deslizando de uma borda da tela.
    </p>
  </header>

  <%= render "components/install", name: "sheet" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Uso</h2>
    <p class="text-sm text-muted-foreground">
      Mesmo contrato do Dialog (elemento
      <code class="rounded bg-muted px-1 py-0.5 text-xs">&lt;dialog&gt;</code> +
      controller <code class="rounded bg-muted px-1 py-0.5 text-xs">ui-dialog</code>),
      com o painel ancorado em uma borda via <code class="rounded bg-muted px-1 py-0.5 text-xs">side:</code>.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Ou renderize os componentes diretamente:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Composição</h2>
    <%= docs_code_block(@composition) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Exemplos</h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Referência da API</h2>
    <p class="text-sm text-muted-foreground">
      Todas as partes aceitam <code class="rounded bg-muted px-1 py-0.5 text-xs">class</code> /
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class_name</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">**attrs</code>.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th>Componente</th>
            <th>Argumento</th>
            <th>Padrão</th>
            <th>Descrição</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>Sheet</code></td>
            <td><code>close_on_backdrop</code></td>
            <td><code>true</code></td>
            <td>Fecha ao clicar fora do painel.</td>
          </tr>
          <tr>
            <td><code>Sheet::Content</code></td>
            <td><code>side</code></td>
            <td><code>:right</code></td>
            <td><code>:right</code>, <code>:left</code>, <code>:top</code>, <code>:bottom</code> — emite <code>data-side</code>.</td>
          </tr>
          <tr>
            <td><code>Sheet::Content</code></td>
            <td><code>show_close_button</code></td>
            <td><code>true</code></td>
            <td>Renderiza o botão X no canto superior direito.</td>
          </tr>
          <tr>
            <td><code>Sheet::Trigger</code> / <code>Sheet::Close</code></td>
            <td><code>variant</code>, <code>size</code></td>
            <td><code>:default</code> / <code>:outline</code></td>
            <td>Encapsulam <code>Ui::ButtonComponent</code>.</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
