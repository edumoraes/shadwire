<%= ui_scroll_area(class: "h-[200px] w-[350px] rounded-md border p-4", data: { testid: "scroll-area-vertical" }) do %>
  <div class="flex flex-col gap-4 text-sm leading-6">
    <% 12.times do |index| %>
      <p>
        Nota de versão <%= index + 1 %>: os componentes Rails são copiados para o app e podem ser editados no lugar depois da instalação.
      </p>
    <% end %>
  </div>
<% end %>
