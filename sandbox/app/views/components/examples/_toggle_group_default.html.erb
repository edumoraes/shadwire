<%= ui_toggle_group(type: :multiple, variant: :outline, "aria-label": "Formatting") do %>
  <%= ui_toggle_group_item(value: "bold", variant: :outline, "aria-label": "Bold") { ui_icon("bold") } %>
  <%= ui_toggle_group_item(value: "italic", variant: :outline, pressed: true, "aria-label": "Italic") { ui_icon("italic") } %>
  <%= ui_toggle_group_item(value: "underline", variant: :outline, "aria-label": "Underline") { ui_icon("underline") } %>
<% end %>
