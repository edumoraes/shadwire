<%= ui_dropdown_menu do %>
  <%= ui_dropdown_menu_trigger(variant: :outline) { "Actions" } %>
  <%= ui_dropdown_menu_content(class: "w-56") do %>
    <%= ui_dropdown_menu_label(inset: true) { "Application" } %>
    <%= ui_dropdown_menu_item(inset: true) { "Duplicate" } %>
    <%= ui_dropdown_menu_item(disabled: true, inset: true) { "Unavailable" } %>
    <%= ui_dropdown_menu_separator %>
    <%= ui_dropdown_menu_item(tag: :a, href: "#docs", inset: true) { "Documentation" } %>
    <%= ui_dropdown_menu_separator %>
    <%= ui_dropdown_menu_item(variant: :destructive) do %>
      <%= ui_icon("trash-2") %>
      Delete
    <% end %>
  <% end %>
<% end %>
