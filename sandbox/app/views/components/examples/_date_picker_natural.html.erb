<%# `natural_language_value: true` turns on the controller's relative vocabulary:
    "today", "tomorrow", "in 2 weeks", "next friday" — alongside the 08/01/2026,
    2026-08-01 and "August 1, 2026" formats. The phrase table is your code: edit
    the controller to suit the language you publish in. %>
<%= ui_field(class: "max-w-xs", data: { controller: "ui-date-picker", ui_date_picker_natural_language_value: "true" }) do %>
  <%= ui_field_label(for: "publish-on") { "Schedule publication" } %>
  <%= ui_input_group do %>
    <%= ui_input_group_input(
          id: "publish-on",
          value: "in 2 days",
          placeholder: "tomorrow or next friday",
          autocomplete: "off",
          data: { ui_date_picker_target: "input" }
        ) %>
    <%= ui_input_group_addon(align: :inline_end) do %>
      <%= ui_popover do %>
        <%= ui_popover_trigger(
              variant: :ghost,
              size: :icon,
              class: "size-6! rounded-sm",
              aria: { label: "Pick a date" }
            ) do %>
          <%= ui_icon("calendar", size: :sm) %>
        <% end %>
        <%= ui_popover_content(align: :end, class: "w-auto! p-0!") do %>
          <%= ui_calendar(name: "post[publish_on]", caption_layout: :dropdown, selected: Date.current + 2) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= ui_field_description do %>
    Your post goes out on
    <span class="font-medium text-foreground" data-ui-date-picker-target="preview"></span>.
  <% end %>
<% end %>
