<%= ui_dialog(close_on_backdrop: false) do %>
  <%= ui_dialog_trigger(variant: :outline) { "No backdrop close" } %>
  <%= ui_dialog_content do %>
    <%= ui_dialog_header do %>
      <%= ui_dialog_title { "Heads up" } %>
      <%= ui_dialog_description { "Clicking outside will not close this dialog — use the X, Esc, or the button below." } %>
    <% end %>
    <%= ui_dialog_footer do %>
      <%= ui_dialog_close { "Got it" } %>
    <% end %>
  <% end %>
<% end %>
