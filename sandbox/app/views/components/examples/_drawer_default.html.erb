<%= ui_drawer do %>
  <%= ui_drawer_trigger(variant: :outline) { "Open drawer" } %>
  <%= ui_drawer_content(class: "mx-auto max-w-md") do %>
    <%= ui_drawer_header do %>
      <%= ui_drawer_title { "Move to trash?" } %>
      <%= ui_drawer_description { "You can restore this item later." } %>
    <% end %>
    <%= ui_drawer_footer do %>
      <%= ui_button { "Confirm" } %>
      <%= ui_drawer_close(variant: :outline) { "Cancel" } %>
    <% end %>
  <% end %>
<% end %>
