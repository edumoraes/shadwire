<%= ui_table(class: "max-w-xl") do %>
  <%= ui_table_caption { "A list of your recent invoices." } %>
  <%= ui_table_header do %>
    <%= ui_table_row do %>
      <%= ui_table_head(scope: "col", class: "w-[100px]") { "Invoice" } %>
      <%= ui_table_head(scope: "col") { "Status" } %>
      <%= ui_table_head(scope: "col") { "Method" } %>
      <%= ui_table_head(scope: "col", class: "text-right") { "Amount" } %>
    <% end %>
  <% end %>
  <%= ui_table_body do %>
    <% [
      [ "INV001", "Paid", "Credit Card", "$250.00" ],
      [ "INV002", "Pending", "Bank Transfer", "$150.00" ],
      [ "INV003", "Paid", "Credit Card", "$350.00" ],
      [ "INV004", "Cancelled", "Credit Card", "$450.00" ]
    ].each do |invoice, status, method, amount| %>
      <%= ui_table_row do %>
        <%= ui_table_cell(class: "font-medium") { invoice } %>
        <%= ui_table_cell { status } %>
        <%= ui_table_cell { method } %>
        <%= ui_table_cell(class: "text-right") { amount } %>
      <% end %>
    <% end %>
  <% end %>
  <%= ui_table_footer do %>
    <%= ui_table_row do %>
      <%= ui_table_cell(colspan: 3) { "Total" } %>
      <%= ui_table_cell(class: "text-right") { "$1,200.00" } %>
    <% end %>
  <% end %>
<% end %>
