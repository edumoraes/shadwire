<%= ui_tabs(default_value: :account, class: "w-full max-w-sm") do %>
  <%= ui_tabs_list(class: "w-full") do %>
    <%= ui_tabs_trigger(value: :account) { "Account" } %>
    <%= ui_tabs_trigger(value: :password) { "Password" } %>
  <% end %>
  <%= ui_tabs_content(value: :account) do %>
    <%= ui_card do %>
      <%= ui_card_header do %>
        <%= ui_card_title { "Account" } %>
        <%= ui_card_description { "Change your profile details here." } %>
      <% end %>
      <%= ui_card_content(class: "grid gap-4") do %>
        <div class="grid gap-2">
          <%= ui_label(for: "tabs-demo-name") { "Name" } %>
          <%= ui_input(id: "tabs-demo-name", value: "Eduardo de Moraes") %>
        </div>
      <% end %>
      <%= ui_card_footer do %>
        <%= ui_button { "Save changes" } %>
      <% end %>
    <% end %>
  <% end %>
  <%= ui_tabs_content(value: :password) do %>
    <%= ui_card do %>
      <%= ui_card_header do %>
        <%= ui_card_title { "Password" } %>
        <%= ui_card_description { "Change your sign-in password here." } %>
      <% end %>
      <%= ui_card_content(class: "grid gap-4") do %>
        <div class="grid gap-2">
          <%= ui_label(for: "tabs-demo-password") { "New password" } %>
          <%= ui_input(id: "tabs-demo-password", type: :password) %>
        </div>
      <% end %>
      <%= ui_card_footer do %>
        <%= ui_button { "Save password" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
