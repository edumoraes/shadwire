<% config = {
     running: { label: "Corrida", color: "var(--chart-1)" },
     swimming: { label: "Natação", color: "var(--chart-2)" }
   }
   rows = [
     { date: Date.new(2024, 7, 15), running: 450, swimming: 300 },
     { date: Date.new(2024, 7, 16), running: 380, swimming: 420 },
     { date: Date.new(2024, 7, 17), running: 520, swimming: 120 },
     { date: Date.new(2024, 7, 18), running: 140, swimming: 550 },
     { date: Date.new(2024, 7, 19), running: 600, swimming: 350 },
     { date: Date.new(2024, 7, 20), running: 480, swimming: 400 }
   ] %>
<div class="grid w-full gap-6 sm:grid-cols-3">
  <% %i[dot line dashed].each do |indicator| %>
    <%= ui_chart(config: config, rows: rows, label: "Calorias gastas por dia",
                 class: "aspect-auto h-[180px] w-full") do %>
      <%= ui_chart_x_axis(data_key: :date, tick_format: "%a") %>
      <%= ui_chart_tooltip(indicator: indicator, label_format: "%A", value_format: ",d", default_index: 1) %>
      <%= ui_chart_bar(data_key: :running, stack_id: :a, radius: [ 0, 0, 4, 4 ]) %>
      <%= ui_chart_bar(data_key: :swimming, stack_id: :a, radius: [ 4, 4, 0, 0 ]) %>
    <% end %>
  <% end %>
</div>
