<%= ui_card(class: "max-w-sm", data: { slot: "card" }) do %>
  <%= ui_card_header(data: { slot: "card-header" }) do %>
    <%= ui_card_title(data: { slot: "card-title" }) { "Create project" } %>
    <%= ui_card_description(data: { slot: "card-description" }) do %>
      Set the name, the visibility, and who joins at the start.
    <% end %>
  <% end %>
  <%= ui_card_content(data: { slot: "card-content" }) do %>
    <p class="text-sm text-muted-foreground">Use cards to group related content and actions.</p>
  <% end %>
  <%= ui_card_footer(class: "justify-end gap-2", data: { slot: "card-footer" }) do %>
    <%= ui_button(variant: :outline, size: :sm) { "Cancel" } %>
    <%= ui_button(size: :sm) { "Create" } %>
  <% end %>
<% end %>
