<%= ui_command(class: "w-80 shadow-md") do %>
  <%= ui_command_input(placeholder: "Type a command or search...") %>
  <%= ui_command_list do %>
    <%= ui_command_empty { "No results found." } %>
    <%= ui_command_group(heading: "Suggestions") do %>
      <%= ui_command_item(value: "calendar") do %>
        <%= ui_icon("calendar") %>
        Calendar
      <% end %>
      <%= ui_command_item(value: "emoji") do %>
        <%= ui_icon("smile") %>
        Search emoji
      <% end %>
    <% end %>
    <%= ui_command_separator %>
    <%= ui_command_group(heading: "Settings") do %>
      <%= ui_command_item(value: "profile") do %>
        <%= ui_icon("user") %>
        Profile
        <%= ui_command_shortcut { "⌘P" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
