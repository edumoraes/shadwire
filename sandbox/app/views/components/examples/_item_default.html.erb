<%= ui_item_group(class: "w-80") do %>
  <%= ui_item(variant: :outline) do %>
    <%= ui_item_media(variant: :icon) { ui_icon("file-text") } %>
    <%= ui_item_content do %>
      <%= ui_item_title { "Report.pdf" } %>
      <%= ui_item_description { "2.4 MB · updated 2 days ago" } %>
    <% end %>
    <%= ui_item_actions do %>
      <%= ui_button(variant: :ghost, size: :icon) { ui_icon("ellipsis", label: "Actions") } %>
    <% end %>
  <% end %>
<% end %>
