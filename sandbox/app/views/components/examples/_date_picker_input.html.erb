<%# Text field + calendar: whatever is typed gets parsed and moves the calendar
    to that date; whatever is picked in the calendar comes back formatted into
    the field. ↓ in the field opens the popover. %>
<%= ui_field(class: "w-60", data: { controller: "ui-date-picker" }) do %>
  <%= ui_field_label(for: "subscribed-on") { "Subscription date" } %>
  <%= ui_input_group do %>
    <%= ui_input_group_input(
          id: "subscribed-on",
          placeholder: "June 1, 2026",
          autocomplete: "off",
          data: { ui_date_picker_target: "input" }
        ) %>
    <%= ui_input_group_addon(align: :inline_end) do %>
      <%= ui_popover do %>
        <%= ui_popover_trigger(
              variant: :ghost,
              size: :icon,
              class: "size-6! rounded-sm",
              aria: { label: "Pick a date" }
            ) do %>
          <%= ui_icon("calendar", size: :sm) %>
        <% end %>
        <%= ui_popover_content(align: :end, class: "w-auto! p-0!") do %>
          <%= ui_calendar(name: "subscribed_on", selected: Date.current) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
