<%= ui_chart(
      config: {
        desktop: { label: "Computador", color: "var(--chart-1)" },
        mobile: { label: "Celular", color: "var(--chart-2)" }
      },
      rows: [
        { month: Date.new(2024, 1), desktop: 186, mobile: 80 },
        { month: Date.new(2024, 2), desktop: 305, mobile: 200 },
        { month: Date.new(2024, 3), desktop: 237, mobile: 120 },
        { month: Date.new(2024, 4), desktop: 73, mobile: 190 },
        { month: Date.new(2024, 5), desktop: 209, mobile: 130 },
        { month: Date.new(2024, 6), desktop: 214, mobile: 140 }
      ],
      label: "Visitantes por mês, computador e celular empilhados",
      class: "min-h-[200px] w-full max-w-xl") do %>
  <%= ui_chart_grid %>
  <%= ui_chart_x_axis(data_key: :month, tick_format: "%b") %>
  <%= ui_chart_tooltip(hide_label: true) %>
  <%= ui_chart_legend %>
  <%= ui_chart_bar(data_key: :desktop, stack_id: :a, radius: [ 0, 0, 4, 4 ]) %>
  <%= ui_chart_bar(data_key: :mobile, stack_id: :a, radius: [ 4, 4, 0, 0 ]) %>
<% end %>
