<%= ui_alert_dialog do %>
  <%= ui_alert_dialog_trigger(variant: :destructive) { "Delete account" } %>
  <%= ui_alert_dialog_content do %>
    <%= ui_alert_dialog_header do %>
      <%= ui_alert_dialog_title { "Are you absolutely sure?" } %>
      <%= ui_alert_dialog_description do %>
        This action cannot be undone. Your account and your data will be permanently
        removed from our servers.
      <% end %>
    <% end %>
    <%= ui_alert_dialog_footer do %>
      <%= ui_alert_dialog_cancel { "Cancel" } %>
      <%= ui_alert_dialog_action { "Continue" } %>
    <% end %>
  <% end %>
<% end %>
