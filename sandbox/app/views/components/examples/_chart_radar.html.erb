<%= ui_chart(
      config: {
        desktop: { label: "Desktop", color: "var(--chart-1)" },
        mobile: { label: "Mobile", color: "var(--chart-2)" }
      },
      rows: [
        { month: Date.new(2024, 1), desktop: 186, mobile: 80 },
        { month: Date.new(2024, 2), desktop: 305, mobile: 200 },
        { month: Date.new(2024, 3), desktop: 237, mobile: 120 },
        { month: Date.new(2024, 4), desktop: 73, mobile: 190 },
        { month: Date.new(2024, 5), desktop: 209, mobile: 130 },
        { month: Date.new(2024, 6), desktop: 214, mobile: 140 }
      ],
      label: "Visitors per month, desktop and mobile",
      class: "mx-auto aspect-square max-h-[280px] w-full") do %>
  <%= ui_chart_tooltip(label_format: "%B", indicator: :line) %>
  <%= ui_chart_polar_grid %>
  <%= ui_chart_polar_angle_axis(data_key: :month, tick_format: "%b") %>
  <%= ui_chart_radar(data_key: :desktop) %>
  <%= ui_chart_radar(data_key: :mobile, fill_opacity: 0.4, dot: true) %>
  <%= ui_chart_legend %>
<% end %>
