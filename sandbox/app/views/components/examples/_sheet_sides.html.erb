<% { right: "Right", left: "Left", top: "Top", bottom: "Bottom" }.each do |side, label| %>
  <%= ui_sheet do %>
    <%= ui_sheet_trigger(variant: :outline) { label } %>
    <%= ui_sheet_content(side: side) do %>
      <%= ui_sheet_header do %>
        <%= ui_sheet_title { "Sheet: #{label.downcase}" } %>
        <%= ui_sheet_description { "This panel slides in from the #{side}." } %>
      <% end %>
      <%= ui_sheet_footer do %>
        <%= ui_sheet_close { "Close" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
