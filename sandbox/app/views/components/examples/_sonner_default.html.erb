<%= ui_sonner do %>
  <div class="flex flex-wrap gap-2">
    <%= ui_button(variant: :outline, data: {
          action: "click->ui-sonner#toast",
          "ui-sonner-title-param": "Event created",
          "ui-sonner-description-param": "Sunday, June 25 at 9:00 PM." }) { "Show toast" } %>

    <%= ui_button(variant: :outline, data: {
          action: "click->ui-sonner#toast",
          "ui-sonner-variant-param": "success",
          "ui-sonner-title-param": "All set!",
          "ui-sonner-description-param": "Your changes have been saved." }) { "Success" } %>

    <%= ui_button(variant: :outline, data: {
          action: "click->ui-sonner#toast",
          "ui-sonner-variant-param": "error",
          "ui-sonner-title-param": "Something went wrong",
          "ui-sonner-description-param": "The record could not be saved." }) { "Error" } %>

    <%= ui_button(variant: :outline, data: {
          action: "click->ui-sonner#toast",
          "ui-sonner-title-param": "File moved to trash",
          "ui-sonner-action-label-param": "Undo" }) { "With an action" } %>
  </div>
<% end %>
