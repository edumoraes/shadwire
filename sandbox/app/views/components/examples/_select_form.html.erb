<%= form_with url: "#", scope: :profile do |form| %>
  <div class="grid w-[240px] gap-2">
    <%= ui_label(for: "profile-role-trigger") { "Role" } %>
    <%= ui_select(name: form.field_name(:role), value: "member", placeholder: "Select", class: "w-full") do %>
      <%= ui_select_trigger(id: "profile-role-trigger", class: "w-full") do %>
        <%= ui_select_value %>
      <% end %>
      <%= ui_select_content do %>
        <%= ui_select_item(value: "admin") { "Admin" } %>
        <%= ui_select_item(value: "member") { "Member" } %>
        <%= ui_select_item(value: "guest") { "Guest" } %>
      <% end %>
    <% end %>
    <p class="text-sm text-muted-foreground">
      The value is submitted through a hidden input — validate on the server.
    </p>
  </div>
<% end %>
