<%= ui_context_menu do %>
  <%= ui_context_menu_trigger(class: "flex h-32 w-72 items-center justify-center rounded-md border border-dashed text-sm text-muted-foreground") { "Right-click here" } %>
  <%= ui_context_menu_content(class: "w-48") do %>
    <%= ui_context_menu_label { "Actions" } %>
    <%= ui_context_menu_item do %>
      Back
      <%= ui_context_menu_shortcut { "⌘[" } %>
    <% end %>
    <%= ui_context_menu_item { "Forward" } %>
    <%= ui_context_menu_separator %>
    <%= ui_context_menu_item(variant: :destructive) { "Delete" } %>
  <% end %>
<% end %>
