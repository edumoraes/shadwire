<%= ui_select(name: "fruit", placeholder: "Pick a fruit", class: "w-[200px]") do %>
  <%= ui_select_trigger(class: "w-full") do %>
    <%= ui_select_value %>
  <% end %>
  <%= ui_select_content do %>
    <%= ui_select_item(value: "apple") { "Apple" } %>
    <%= ui_select_item(value: "banana") { "Banana" } %>
    <%= ui_select_item(value: "blueberry") { "Blueberry" } %>
    <%= ui_select_item(value: "grapes") { "Grapes" } %>
    <%= ui_select_item(value: "pineapple") { "Abacaxi" } %>
  <% end %>
<% end %>
