<%# Date and time are two fields: the picker settles the day, a native
    `input type="time"` settles the hour. The browser's own indicator is hidden
    so it does not compete with the field's icon. %>
<div class="flex max-w-xs gap-4">
  <%= ui_field(data: { controller: "ui-date-picker" }) do %>
    <%= ui_field_label(for: "meeting-on") { "Date" } %>
    <%= ui_popover do %>
      <%= ui_popover_trigger(id: "meeting-on", variant: :outline, class: "w-36 justify-between font-normal") do %>
        <span data-ui-date-picker-target="label" data-empty="true" class="data-[empty=true]:text-muted-foreground">
          Pick one
        </span>
        <%= ui_icon("chevron-down", class: "opacity-50") %>
      <% end %>
      <%= ui_popover_content(align: :start, class: "w-auto! p-0!") do %>
        <%= ui_calendar(name: "meeting[on]", caption_layout: :dropdown) %>
      <% end %>
    <% end %>
  <% end %>

  <%= ui_field(class: "w-32") do %>
    <%= ui_field_label(for: "meeting-at") { "Time" } %>
    <%= ui_input(
          type: :time,
          id: "meeting-at",
          name: "meeting[at]",
          step: 1,
          value: "10:30:00",
          class: "appearance-none bg-background [&::-webkit-calendar-picker-indicator]:hidden"
        ) %>
  <% end %>
</div>
