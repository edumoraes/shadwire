<% content_for :title, "Date Picker — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Date Picker</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A recipe: Popover + Calendar. Not a new component — there is no
      <code class="rounded bg-muted px-1 py-0.5 text-base">Ui::DatePickerComponent</code>,
      you compose the parts yourself.
    </p>
  </header>

  <%= render "components/install", name: "date-picker" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_calendar</code> is what holds the value:
      it writes the chosen date into a hidden input (<code class="rounded bg-muted px-1 py-0.5 text-xs">name:</code>)
      e anuncia <code class="rounded bg-muted px-1 py-0.5 text-xs">ui-calendar:change</code>.
      O controller <code class="rounded bg-muted px-1 py-0.5 text-xs">ui-date-picker</code> ouve esse evento
      to write the formatted date into the trigger's label and close the popover — presentation, nothing more.
      Without it the picker still works; it just never tells the user what was chosen.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      The popover needs <code class="rounded bg-muted px-1 py-0.5 text-xs">w-auto! p-0!</code>:
      the default is <code class="rounded bg-muted px-1 py-0.5 text-xs">w-72</code> with padding,
      too narrow for the calendar grid. The <code class="rounded bg-muted px-1 py-0.5 text-xs">!</code>
      goes at the end of the class — that is Tailwind v4 syntax.
    </p>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <%= docs_code_block(@composition, language: :text) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <p class="text-sm text-muted-foreground">
      The eight arrangements shadcn/ui documents, translated into ViewComponent + Stimulus.
    </p>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      What the calendar accepts is documented under <%= link_to "Calendar", components_calendar_path, class: "underline underline-offset-4" %>.
      Below, only the wiring controller — <code class="rounded bg-muted px-1 py-0.5 text-xs">data-*</code> attributes
      on the element wrapping the popover and the field.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th>Atributo</th>
            <th><%= t("components.api.default") %></th>
            <th><%= t("components.api.description") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>format-value</code></td>
            <td><code>long</code></td>
            <td><code>full</code>, <code>long</code>, <code>medium</code>, <code>short</code> ou <code>iso</code>.</td>
          </tr>
          <tr>
            <td><code>locale-value</code></td>
            <td>—</td>
            <td>BCP 47 (<code>pt-BR</code>, <code>ar-EG</code>). Empty follows the browser's language.</td>
          </tr>
          <tr>
            <td><code>separator-value</code></td>
            <td><code>&nbsp;–&nbsp;</code></td>
            <td>What separates the two ends of a range in the label.</td>
          </tr>
          <tr>
            <td><code>date-order-value</code></td>
            <td><code>dmy</code></td>
            <td>How to read <code>01/06/2026</code> as you type. <code>mdy</code> for the US order.</td>
          </tr>
          <tr>
            <td><code>close-on-select-value</code></td>
            <td><code>true</code></td>
            <td>Closes the popover on selection. With <code>mode: :range</code>, only once the second date lands.</td>
          </tr>
          <tr>
            <td><code>natural-language-value</code></td>
            <td><code>false</code></td>
            <td>Accepts relative phrases (“tomorrow”, “in 2 weeks”, “next friday”) in the text field.</td>
          </tr>
          <tr>
            <td><code>target="label"</code></td>
            <td>—</td>
            <td>The element whose text becomes the chosen date; it gets <code>data-empty</code> while empty.</td>
          </tr>
          <tr>
            <td><code>target="input"</code></td>
            <td>—</td>
            <td>An editable text field: what you type is parsed, and <kbd class="rounded bg-muted px-1 text-xs">↓</kbd> opens the popover.</td>
          </tr>
          <tr>
            <td><code>target="preview"</code></td>
            <td>—</td>
            <td>An optional echo of the parsed date, for a supporting line below the field.</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
