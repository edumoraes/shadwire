<% content_for :title, "Tooltip — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Tooltip</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      A bubble showing information related to an element on hover or focus.
    </p>
  </header>

  <%= render "components/install", name: "tooltip" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      O controller <code class="rounded bg-muted px-1 py-0.5 text-xs">ui-tooltip</code>
      opens on hover or focus after a delay, ties the trigger to the bubble through
      <code class="rounded bg-muted px-1 py-0.5 text-xs">aria-describedby</code>, and closes on
      <kbd class="rounded bg-muted px-1 text-xs">Esc</kbd> without moving focus (WCAG 1.4.13).
      The content lives inside the root, so the pointer can move onto it without closing it.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">
      Or render the components directly:
    </p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <%= docs_code_block(@composition) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      Every part accepts <code class="rounded bg-muted px-1 py-0.5 text-xs">class</code> /
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class_name</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">**attrs</code>.
    </p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50">
          <tr>
            <th><%= t("components.api.component") %></th>
            <th><%= t("components.api.argument") %></th>
            <th><%= t("components.api.default") %></th>
            <th><%= t("components.api.description") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>Tooltip</code></td>
            <td><code>open_delay</code></td>
            <td><code>300</code></td>
            <td>The delay in milliseconds before it opens on hover.</td>
          </tr>
          <tr>
            <td><code>Tooltip::Trigger</code></td>
            <td><code>variant</code>, <code>size</code></td>
            <td><code>:outline</code></td>
            <td>Wraps <code>Ui::ButtonComponent</code>; gains <code>aria-describedby</code> once connected.</td>
          </tr>
          <tr>
            <td><code>Tooltip::Content</code></td>
            <td><code>side</code></td>
            <td><code>:top</code></td>
            <td><code>:top</code>, <code>:right</code>, <code>:bottom</code>, <code>:left</code>.</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
