<% content_for :title, "Componentes — Shadwire" %>
<% content_for :description, "O catálogo de componentes do Shadwire: ports em ViewComponent dos componentes do shadcn/ui, cada um com exemplos ao vivo, código de uso e referência de API." %>

<article class="space-y-8">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Componentes</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Ports em ViewComponent dos componentes do shadcn/ui. Abra cada página para ver
      exemplos ao vivo, código de uso e a referência da API.
    </p>
  </header>

  <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
    <%= ui_badge(variant: :secondary) { "#{docs_component_items.size} componentes" } %>
    <span>
      Instale qualquer um com <%= docs_code("bin/shadwire add <nome>") %>.
      Veja <%= link_to "Instalação", docs_installation_path, class: "font-medium underline underline-offset-4" %>.
    </span>
  </div>

  <%# A lista vem do registry, então um componente novo aparece aqui assim que tiver rota. %>
  <nav aria-label="Componentes">
    <ul class="grid gap-3 sm:grid-cols-2">
      <% docs_component_items.sort_by { |item| item.fetch("title").downcase }.each do |item| %>
        <li>
          <%= link_to docs_component_path(item.fetch("name")), class: "group flex h-full flex-col gap-1 rounded-lg border bg-card px-4 py-3 text-card-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] focus-visible:outline-none" do %>
            <span class="flex items-center justify-between gap-2 text-sm font-medium">
              <%= item.fetch("title") %>
              <span aria-hidden="true" class="text-muted-foreground transition-transform group-hover:translate-x-0.5">→</span>
            </span>
            <span class="text-sm leading-6 text-muted-foreground group-hover:text-accent-foreground">
              <%= registry_description(item) %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</article>
