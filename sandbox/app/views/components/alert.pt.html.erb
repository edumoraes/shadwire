<% content_for :title, "Alert — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.92] sm:text-5xl">Alert</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Um bloco de aviso, com semântica de alerta, para mensagens importantes.
    </p>
  </header>

  <%= render "components/install", name: "alert" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Ou renderize <code class="rounded bg-muted px-1 py-0.5 text-xs">Ui::AlertComponent</code> diretamente:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_alert</code>,
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_alert_title</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_alert_description</code> encapsulam os
      componentes correspondentes. Um <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_icon</code>
      colocado primeiro ganha uma coluna própria, e o texto se alinha ao lado dele. Toda parte aceita
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class</code> /
      <code class="rounded bg-muted px-1 py-0.5 text-xs">class_name</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">**attrs</code>.
    </p>
    <%= render layout: "docs/table", locals: { headers: [ t("components.api.component"), t("components.api.argument"), t("components.api.default"), t("components.api.description") ] } do %>
      <tr><td><code>Alert</code></td><td><code>variant</code></td><td><code>:default</code></td><td><code>:default</code> ou <code>:destructive</code>.</td></tr>
      <tr><td><code>Alert</code></td><td><code>role</code> (atributo)</td><td><code>"alert"</code></td><td>Pode ser sobrescrito quando a mensagem não deve ser anunciada imediatamente.</td></tr>
      <tr><td><code>Alert::Title</code></td><td>—</td><td>—</td><td>A linha de título, limitada a uma linha.</td></tr>
      <tr><td><code>Alert::Description</code></td><td>—</td><td>—</td><td>O corpo, em tom neutro; comporta uma linha de texto ou vários <code>&lt;p&gt;</code>.</td></tr>
    <% end %>
  </section>
</article>
