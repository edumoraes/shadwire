<% content_for :title, "Scroll Area — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="flex flex-col gap-12">
  <header class="flex flex-col gap-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Scroll Area</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Improves native scrolling with a styled scrollbar that looks the same across browsers.
    </p>
  </header>

  <%= render "components/install", name: "scroll-area" %>

  <section class="flex flex-col gap-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.usage") %></h2>
    <p class="text-sm text-muted-foreground">
      Use the helper in Rails views, or render the ViewComponent class directly
      when you need the object API.
    </p>
    <%= docs_code_block(@usage_helper) %>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.composition") %></h2>
    <p class="text-sm text-muted-foreground">
      shadcn's anatomy is <code class="rounded bg-muted px-1 py-0.5 text-xs">ScrollArea</code>
      with an optional <code class="rounded bg-muted px-1 py-0.5 text-xs">ScrollBar</code>.
      No Shadwire, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_scroll_area</code>
      renders the viewport, the content, the bars, the thumb and the corner for you.
    </p>
    <%= docs_code_block(@composition, language: :text) %>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.examples") %></h2>
    <%= render "components/example", **@examples.first %>

    <div class="flex flex-col gap-3">
      <h3 class="text-xl font-bold tracking-[-0.01em]">Horizontal</h3>
      <p class="text-sm text-muted-foreground">
        Use <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_scroll_bar(orientation: :horizontal)</code>
        or pass <code class="rounded bg-muted px-1 py-0.5 text-xs">scrollbars: [ :horizontal ]</code>
        for horizontal scrolling.
      </p>
      <%= render "components/example", **@examples.second %>
    </div>
    <%= docs_code_block(@usage_horizontal) %>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">RTL</h2>
    <p class="text-sm text-muted-foreground">
      Pass the standard HTML direction attributes through the component when rendering
      right-to-left content.
    </p>
    <%= render "components/example", **@examples.third %>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]"><%= t("components.sections.api") %></h2>
    <p class="text-sm text-muted-foreground">
      This Rails port mirrors those Base UI-style parts with ViewComponent
      classes and data attributes. The helpers preserve free-form HTML
      livres, incluindo <code class="rounded bg-muted px-1 py-0.5 text-xs">data:</code> e
      <code class="rounded bg-muted px-1 py-0.5 text-xs">aria:</code>.
    </p>
    <%= render layout: "docs/table", locals: { headers: [ "Helper", t("components.api.main_arguments"), t("components.api.description") ] } do %>
      <tr>
        <td><code>ui_scroll_area</code></td>
        <td><code>scrollbars</code>, <code>class</code> / <code>class_name</code></td>
        <td>The root component: renders the viewport, content, bars, corner and the Stimulus controller.</td>
      </tr>
      <tr>
        <td><code>ui_scroll_bar</code></td>
        <td><code>orientation</code></td>
        <td>An optional subcomponent for a vertical or horizontal bar.</td>
      </tr>
      <tr>
        <td><code>Ui::ScrollAreaComponent</code></td>
        <td><code>scrollbars</code>, atributos HTML</td>
        <td>The ViewComponent API for rendering the Rails port directly.</td>
      </tr>
    <% end %>
  </section>
</article>
