<% content_for :title, "Card — Shadwire" %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <header class="space-y-3">
    <h1 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95]">Card</h1>
    <p class="text-lg leading-snug text-muted-foreground">
      Uma superfície com borda para agrupar conteúdo relacionado.
    </p>
  </header>

  <%= render "components/install", name: "card" %>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Uso</h2>
    <%= docs_code_block(@usage_helper) %>
    <p class="text-sm text-muted-foreground">Ou renderize os componentes diretamente:</p>
    <%= docs_code_block(@usage_component) %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Composição</h2>
    <%= docs_code_block(@composition, language: :text) %>
  </section>

  <section class="space-y-8">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Exemplos</h2>
    <% @examples.each do |example| %>
      <%= render "components/example", **example %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="border-b pb-2 text-2xl font-bold tracking-[-0.01em]">Referência da API</h2>
    <p class="text-sm text-muted-foreground">Helpers disponíveis: <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_header</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_title</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_description</code>, <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_content</code> e <code class="rounded bg-muted px-1 py-0.5 text-xs">ui_card_footer</code>.</p>
    <%= ui_card(class: "overflow-x-auto") do %>
      <table class="w-full text-left text-sm [&_td]:border-t [&_td]:p-3 [&_td]:align-top [&_th]:p-3 [&_th]:font-medium">
        <thead class="bg-muted/50"><tr><th>API</th><th>Elemento</th><th>Descrição</th></tr></thead>
        <tbody>
          <tr><td><code>ui_card</code></td><td><code>div</code></td><td>Container com borda, superfície card e sombra.</td></tr>
          <tr><td><code>ui_card_header</code></td><td><code>div</code></td><td>Área superior com espaçamento vertical.</td></tr>
          <tr><td><code>ui_card_title</code></td><td><code>h3</code></td><td>Título; aceita <code>tag_name:</code>.</td></tr>
          <tr><td><code>ui_card_description</code></td><td><code>p</code></td><td>Texto auxiliar em muted foreground.</td></tr>
          <tr><td><code>ui_card_content</code></td><td><code>div</code></td><td>Conteúdo principal.</td></tr>
          <tr><td><code>ui_card_footer</code></td><td><code>div</code></td><td>Ações ou metadados inferiores.</td></tr>
        </tbody>
      </table>
    <% end %>
  </section>
</article>
