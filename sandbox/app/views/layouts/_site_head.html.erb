<%# Shared <head> for the landing page and the documentation shell. %>
<title><%= content_for(:title) || "Shadwire" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Shadwire">
<meta name="mobile-web-app-capable" content="yes">
<% if content_for?(:description) %>
  <meta name="description" content="<%= content_for(:description).to_s.squish %>">
<% end %>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<%# Aplica o tema salvo antes da primeira pintura para evitar flash. %>
<script>
  (() => {
    const stored = localStorage.getItem("theme")
    const dark = stored
      ? stored === "dark"
      : window.matchMedia("(prefers-color-scheme: dark)").matches
    document.documentElement.classList.toggle("dark", dark)
  })()
</script>

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
