<% content_for :title, "Forms — Shadwire" %>
<% content_for :description, "The field components, validation state, using the controls with form_with, and choosing the right control for Shadwire forms." %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <%= render "docs/header",
        title: "Forms",
        description: "Lay out each form row with field, and connect the controls to form_with yourself. There is no form builder." %>

  <section class="space-y-4">
    <%= docs_h2("Wrap every control in ui_field") %>
    <p class="leading-7 text-muted-foreground">
      Don't build form rows out of <%= docs_code("div") %>s and spacing utilities.
      <%= docs_code("field") %> already takes care of the label, the description, the error
      message and the spacing between them.
    </p>

    <%= docs_code_block(@snippets[:wrong_field]) %>
    <%= docs_code_block(@snippets[:right_field]) %>

    <p class="leading-7 text-muted-foreground">All the field parts:</p>

    <%= render "docs/table",
          headers: [ "Helper", "Role" ],
          rows: [
            [ docs_code("ui_field"), "The row. Takes orientation: :vertical (default), :horizontal or :responsive." ],
            [ docs_code("ui_field_group"), "Stacks several fields with consistent spacing." ],
            [ docs_code("ui_field_set") + " + " + docs_code("ui_field_legend"), "Groups related checkboxes or radios, instead of a div with a heading." ],
            [ docs_code("ui_field_label"), "The field's label." ],
            [ docs_code("ui_field_title") + " / " + docs_code("ui_field_description"), "Supporting text above and below the control." ],
            [ docs_code("ui_field_error"), "The error message, with role=\"alert\"." ],
            [ docs_code("ui_field_content"), "Wraps the control when it needs a container of its own." ],
            [ docs_code("ui_field_separator"), "Divides sections inside a group." ]
          ] %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("Validation state") %>
    <p class="leading-7 text-muted-foreground">
      Pass <%= docs_code("invalid: true") %> to <%= docs_code("ui_field") %>. It sets
      <%= docs_code("data-invalid") %> and turns the row's text red (the destructive colour).
      The message goes in <%= docs_code("ui_field_error") %>.
    </p>

    <%= docs_code_block(@snippets[:invalid]) %>

    <p class="leading-7 text-muted-foreground">
      <%= docs_code("ui_field_error") %> takes either block content or an array in
      <%= docs_code("errors:") %>, and renders nothing when both are empty, so you can always
      leave it in the template without an <%= docs_code("if") %>.
    </p>
  </section>

  <section class="space-y-4">
    <%= docs_h2("There is no form builder integration") %>
    <p class="leading-7 text-muted-foreground">
      There is no <%= docs_code("f.ui_input") %>. The controls pass any HTML attribute through
      to the element, so you connect them to <%= docs_code("form_with") %> yourself:
    </p>

    <%= docs_code_block(@snippets[:form_with]) %>

    <p class="leading-7 text-muted-foreground">
      <%= docs_code("form.field_name") %> and <%= docs_code("form.field_id") %> produce the
      <%= docs_code("user[email]") %> and <%= docs_code("user_email") %> names Rails expects, so
      the params arrive as usual. The same works for
      <%= docs_code("ui_checkbox") %>, <%= docs_code("ui_switch") %>,
      <%= docs_code("ui_textarea") %>, <%= docs_code("ui_select") %>,
      <%= docs_code("ui_radio_group") %> and <%= docs_code("ui_slider") %>.
    </p>

    <%= render layout: "docs/callout", locals: { icon: "triangle-alert", title: "Checkbox does not emit Rails' hidden input" } do %>
      Unlike <code>form.check_box</code>, it doesn't add a hidden field with the unchecked
      value. Treat a missing parameter as unchecked, or add the hidden input yourself when the
      form has to send a value either way:
    <% end %>

    <%= docs_code_block(@snippets[:checkbox_hidden]) %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("Choosing the control") %>

    <%= render "docs/table",
          headers: [ "Situation", "Control" ],
          rows: [
            [ "One line of text", docs_code("ui_input") ],
            [ "Several lines", docs_code("ui_textarea") ],
            [ "Text with a prefix, suffix or button", docs_code("ui_input_group") ],
            [ "One of a long list", safe_join([ docs_code("ui_select"), ", or ", docs_code("combobox"), " if people need to search it" ]) ],
            [ "One of a few visible options", docs_code("ui_radio_group") ],
            [ "The native picker on mobile, no JS", docs_code("ui_native_select") ],
            [ "Several independent choices", docs_code("ui_checkbox") ],
            [ "Two to seven compact choices", docs_code("ui_toggle_group") ],
            [ "A setting applied immediately", docs_code("ui_switch") ],
            [ "An approximate number", docs_code("ui_slider") ],
            [ "An exact number", docs_code("ui_input(type: :number)") ],
            [ "A date or a range", safe_join([ docs_code("date-picker"), ", or ", docs_code("ui_calendar"), " inline" ]) ],
            [ "A one-time code", docs_code("ui_input_otp") ]
          ] %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("The date picker is a recipe") %>
    <p class="leading-7 text-muted-foreground">
      There is no <%= docs_code("Ui::DatePickerComponent") %>. A date field is a
      <%= docs_code("ui_popover") %> with a <%= docs_code("ui_calendar") %> inside, and the
      <%= docs_code("ui-date-picker") %> controller shows the chosen date on the trigger and
      closes the popover. The calendar holds the value: give it <%= docs_code("name:") %> and it
      renders a hidden input, so the date is submitted like any other field.
    </p>

    <%= docs_code_block(@snippets[:date_picker]) %>

    <p class="leading-7 text-muted-foreground">
      The popover needs <%= docs_code("w-auto! p-0!") %>, because its default
      <%= docs_code("w-72") %> and padding leave too little room for the calendar. The
      variations are calendar arguments:
      <%= docs_code("mode: :range") %>, <%= docs_code("caption_layout: :dropdown") %>,
      <%= docs_code("dir: :rtl") %>.
      <%= docs_code("bin/shadwire info date-picker") %> lists them all, and the
      <%= link_to "Date Picker page", components_date_picker_path, class: "font-medium underline underline-offset-4" %>
      shows each one live.
    </p>
  </section>

  <section class="space-y-4">
    <%= docs_h2("Input group has its own input") %>
    <p class="leading-7 text-muted-foreground">
      Inside <%= docs_code("ui_input_group") %>, use the group's own helpers instead of a plain
      <%= docs_code("ui_input") %>.
    </p>

    <%= docs_code_block(@snippets[:wrong_input_group]) %>
    <%= docs_code_block(@snippets[:right_input_group]) %>
  </section>
</article>
