<%# A titled note. Locals: icon, title, variant (:default / :destructive).
    The block is the body.

    Renders through ui_alert, which is a single element by design; the icon +
    title + body anatomy is composed here, as the Alert docs show it. %>
<%= ui_alert(variant: local_assigns.fetch(:variant, :default), class: "not-prose") do %>
  <div class="flex gap-3">
    <%= ui_icon(icon, class: "mt-0.5 shrink-0") %>
    <div class="grid min-w-0 gap-1">
      <p class="font-medium leading-none"><%= title %></p>
      <div class="<%= class_names("text-sm leading-6", ("text-muted-foreground" unless local_assigns[:variant] == :destructive)) %> [&_code]:rounded [&_code]:bg-muted [&_code]:px-[0.3rem] [&_code]:py-[0.2rem] [&_code]:font-mono [&_code]:text-[0.8125rem]">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
