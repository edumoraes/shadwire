<% content_for :title, "llms.txt — Shadwire" %>
<% content_for :description, "Shadwire's catalog in plain text, for agents that cannot use the skill or run the CLI." %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <%= render "docs/header",
        title: "llms.txt",
        description: "The component catalog in plain text, for agents that have neither the skill nor a way to run the CLI." %>

  <section class="space-y-4">
    <p class="leading-7">
      The <%= link_to "agent skill", docs_agent_skill_path, class: "font-medium underline underline-offset-4" %>
      is the better option, because it looks at your app and knows what is installed. But not
      every agent supports skills, and not every agent can run commands. For those cases the
      registry also comes in two plain-text files, generated from the same data.
    </p>

    <%= render "docs/table",
          headers: [ "File", "Contents", "When to use it" ],
          rows: [
            [ link_to(docs_code("/r/llms.txt"), "https://shadwire.edumoraes.dev.br/r/llms.txt", target: "_blank", rel: "noopener"),
              "Every component with its title, description and when-to-use text.",
              "Choosing a component. It is small enough for any context window." ],
            [ link_to(docs_code("/r/llms-full.txt"), "https://shadwire.edumoraes.dev.br/r/llms-full.txt", target: "_blank", rel: "noopener"),
              "Everything in llms.txt, plus the full API: helpers, variants, sizes, arguments and usage examples.",
              "Writing ERB with no way to consult the CLI." ]
          ] %>

    <%= docs_code_block(@snippets[:fetch], language: :shell) %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("Format") %>
    <p class="leading-7 text-muted-foreground">
      Plain Markdown, following the
      <%= link_to "llms.txt", "https://llmstxt.org", target: "_blank", rel: "noopener", class: "font-medium underline underline-offset-4" %>
      convention: a title, a short summary, and sections for how to install, the licence of the
      code, and the catalog itself.
    </p>

    <%= docs_code_block(@snippets[:sample], language: :markdown) %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("What they can't tell you") %>
    <p class="leading-7 text-muted-foreground">
      These files describe the <em>registry</em>, not <em>your app</em>. They list all
      <%= docs_component_items.size %> components, including the ones you have not installed,
      and the helpers of those components do not exist in your app.
    </p>

    <%= render layout: "docs/callout", locals: { icon: "triangle-alert", title: "Installing by hand leaves shadwire.json inaccurate" } do %>
      You can copy the code out of <code>llms-full.txt</code>, but then the list in
      <code>shadwire.json</code> is not updated, and <code>diff</code>, <code>update</code> and
      <code>remove</code> rely on it. If you can run the CLI, use it.
    <% end %>
  </section>
</article>
