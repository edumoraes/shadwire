<% content_for :title, "llms.txt — Shadwire" %>
<% content_for :description, "Shadwire's catalog in plain text, for agents that install no skill and cannot run the CLI." %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<article class="space-y-12">
  <%= render "docs/header",
        title: "llms.txt",
        description: "The same catalog in plain text, for when the agent has neither the skill nor a way to run the CLI." %>

  <section class="space-y-4">
    <p class="leading-7">
      The <%= link_to "agent skill", docs_agent_skill_path, class: "font-medium underline underline-offset-4" %>
      is the preferred route: it reads the app and knows what is installed. But not every agent
      installs skills, and not every context has a shell. For those, the registry build publishes
      two plain-text variants, generated from the same data.
    </p>

    <%= render "docs/table",
          headers: [ "File", "Contents", "When to use it" ],
          rows: [
            [ link_to(docs_code("/r/llms.txt"), "https://shadwire.edumoraes.dev.br/r/llms.txt", target: "_blank", rel: "noopener"),
              "Every component with its title, description and when-to-use text.",
              "Choosing the right component. Fits comfortably in any context window." ],
            [ link_to(docs_code("/r/llms-full.txt"), "https://shadwire.edumoraes.dev.br/r/llms-full.txt", target: "_blank", rel: "noopener"),
              "The above plus the full API: helpers, variants, sizes, props and usage snippets.",
              "Writing ERB with no way to consult the CLI." ]
          ] %>

    <%= docs_code_block(@snippets[:fetch], language: :shell) %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("Format") %>
    <p class="leading-7 text-muted-foreground">
      Plain Markdown, following the
      <%= link_to "llms.txt", "https://llmstxt.org", target: "_blank", rel: "noopener", class: "font-medium underline underline-offset-4" %>
      convention: a title, a blockquoted summary, and sections by area.
    </p>

    <%= docs_code_block(@snippets[:sample], language: :markdown) %>
  </section>

  <section class="space-y-4">
    <%= docs_h2("The limitation") %>
    <p class="leading-7 text-muted-foreground">
      These files describe the <em>registry</em>, not <em>your app</em>. They list all
      <%= docs_component_items.size %> components, including the ones you never installed — and
      the helper of a component you did not install does not exist.
    </p>

    <%= render layout: "docs/callout", locals: { icon: "triangle-alert", title: "Installing by hand leaves shadwire.json inaccurate" } do %>
      You can copy the code out of <code>llms-full.txt</code>, but the inventory in
      <code>shadwire.json</code> is not updated — and that inventory is what makes
      <code>diff</code>, <code>update</code> and <code>remove</code> work. If the CLI is
      available, use the CLI.
    <% end %>
  </section>
</article>
