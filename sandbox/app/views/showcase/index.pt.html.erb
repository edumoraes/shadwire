<% content_for :title, "Shadwire — componentes shadcn/ui para Ruby on Rails" %>
<% content_for :description do %>
  O Shadwire porta o modelo Open Code do shadcn/ui para o Ruby on Rails: código
  ViewComponent aberto e copiável, que seu app instala e passa a possuir, sem gem em runtime.
<% end %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<%# 1. Hero — a única folha branca do topo da página, fechando na curva. %>
<section class="relative bg-card">
  <div class="mx-auto max-w-6xl px-5 pb-24 pt-20 text-center sm:pb-32 sm:pt-28">
    <%= ui_badge(variant: :secondary, class: "mb-6 font-mono text-xs font-medium tracking-[0.02em]") do %>
      v<%= registry_version %> · Rails + ViewComponent
    <% end %>
    <h1 class="mx-auto max-w-4xl text-balance text-5xl font-bold tracking-[-0.01em] leading-[0.92] text-primary sm:text-6xl lg:text-7xl">
      Componentes shadcn/ui que viram código seu.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-balance text-xl leading-[1.2] tracking-[-0.006em] text-muted-foreground sm:text-2xl">
      Shadwire porta o modelo <strong class="font-semibold text-foreground">Open Code</strong> do
      shadcn/ui para o Ruby on Rails: código de componentes ViewComponent aberto e copiável,
      que seu app instala e passa a possuir, sem nenhuma gem em runtime.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <%= ui_button(tag: :a, href: docs_path, size: :lg) do %>
        Começar<%= ui_icon("arrow-right", size: :sm) %>
      <% end %>
      <%= ui_button(tag: :a, href: components_path, variant: :outline, size: :lg) do %>
        Ver componentes
      <% end %>
      <%= ui_button(tag: :a, href: "https://github.com/edumoraes/shadwire", target: "_blank", rel: "noopener", variant: :ghost, size: :lg) do %>
        <%= ui_icon("github", size: :sm) %>GitHub
      <% end %>
    </div>
  </div>

  <%# A única curva do site. A referência sobe e desce o fundo várias vezes na
      página; uma vez, aqui, já carrega a referência e ainda se lê como decisão,
      não como maneirismo. %>
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 block h-14 w-full fill-background sm:h-24"
       viewBox="0 0 1440 96" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 96V62C420 6 1020 22 1440 44V96Z" />
  </svg>
</section>

<%# 2. Construído com (prova social / stack) %>
<section>
  <div class="mx-auto max-w-6xl px-5 py-14">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.04em] text-muted-foreground">
      Construído sobre
    </p>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <% [
        "Ruby on Rails 8.1",
        "ViewComponent 4",
        "Tailwind CSS v4",
        "shadcn/ui",
        "Lucide",
        "Stimulus · Turbo"
      ].each do |label| %>
        <li>
          <span class="inline-flex items-center rounded-full border bg-card px-4 py-1.5 text-sm font-medium text-card-foreground shadow-xs">
            <%= label %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%# 3. Tudo que você precisa (showcase com preview + código) %>
<section>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-[-0.01em] leading-[0.92] text-primary sm:text-5xl">Tudo que você precisa.</h2>
      <p class="mt-4 text-lg leading-snug text-muted-foreground sm:text-xl">
        Componentes acessíveis prontos para copiar, de botões e formulários a diálogos e
        sidebars. Veja alguns ao vivo, com o código ao lado.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl">
      <%= ui_tabs(default_value: @showcase.first[:name], class: "w-full") do %>
        <%= ui_tabs_list(class: "mx-auto flex w-fit flex-wrap") do %>
          <% @showcase.each do |example| %>
            <%= ui_tabs_trigger(value: example[:name]) { example[:title] } %>
          <% end %>
        <% end %>
        <% @showcase.each do |example| %>
          <%= ui_tabs_content(value: example[:name]) do %>
            <%= render "components/example", **example %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# 4. O código é seu (filosofia / Open Code) — a segunda folha branca.
    Os três princípios são colunas, não cards: um card nesse painel seria branco
    sobre branco, e os painéis brancos da referência trazem tipografia pura. %>
<section class="px-4 py-8 sm:px-6 sm:py-12">
  <div class="mx-auto max-w-6xl rounded-[1.75rem] bg-card px-5 py-16 sm:px-12 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-[-0.01em] leading-[0.92] text-primary sm:text-5xl">O código é seu.</h2>
      <p class="mt-4 text-lg leading-snug text-muted-foreground sm:text-xl">
        Shadwire não é uma gem de runtime. Você instala o código-fonte dos componentes no
        seu app e passa a mantê-lo, com liberdade para adaptar.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl gap-10 sm:grid-cols-3">
      <% [
        { icon: "package-open", title: "Você é dono",
          description: "Os arquivos são copiados para o seu projeto e funcionam sem nenhuma dependência do Shadwire." },
        { icon: "accessibility", title: "Acessível por padrão",
          description: "Semântica ARIA e padrões do APG embutidos em cada componente." },
        { icon: "palette", title: "Tokens semânticos",
          description: "Estilizado com tokens shadcn (bg-primary, text-muted-foreground…) e dark mode pronto." }
      ].each do |principle| %>
        <div>
          <span class="inline-flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <%= ui_icon(principle[:icon], size: :lg) %>
          </span>
          <h3 class="mt-4 text-lg font-semibold tracking-[-0.006em]"><%= principle[:title] %></h3>
          <p class="mt-2 leading-7 text-muted-foreground"><%= principle[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 5. Comece agora (getting started) %>
<section>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-[-0.01em] leading-[0.92] text-primary sm:text-5xl">Comece agora.</h2>
      <p class="mt-4 text-lg leading-snug text-muted-foreground sm:text-xl">
        Explore o catálogo, veja composições prontas ou acompanhe o projeto no GitHub.
      </p>
    </div>

    <%# A aba sobre cada card nomeia o verbo, não o destino: o título logo abaixo
        já diz onde você chega. %>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { eyebrow: "Aprender", icon: "book-open", title: "Documentação", description: "Instalação, CLI, agent skill, theming e os guias de composição, estilo e formulários.", cta: "Ler a documentação", path: docs_path, external: false },
        { eyebrow: "Explorar", icon: "blocks", title: "Componentes", description: "#{docs_component_items.size} componentes documentados, com exemplos ao vivo e referência de API.", cta: "Ver catálogo", path: components_path, external: false },
        { eyebrow: "Compor", icon: "layout-dashboard", title: "Blocks", description: "Composições prontas a partir dos componentes, como a sidebar-01.", cta: "Ver blocks", path: blocks_path, external: false },
        { eyebrow: "Contribuir", icon: "github", title: "GitHub", description: "Veja o código-fonte, o registry e contribua com o projeto.", cta: "Abrir repositório", path: "https://github.com/edumoraes/shadwire", external: true }
      ].each do |card| %>
        <%= link_to card[:path],
              **(card[:external] ? { target: "_blank", rel: "noopener" } : {}),
              class: "group relative flex h-full flex-col gap-3 rounded-xl border bg-card p-6 text-card-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] focus-visible:outline-none" do %>
          <span aria-hidden="true" class="absolute -top-3 left-5 inline-flex items-center rounded-md bg-primary px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.04em] text-primary-foreground">
            <%= card[:eyebrow] %>
          </span>
          <span class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <%= ui_icon(card[:icon], size: :lg) %>
          </span>
          <span class="text-lg font-semibold tracking-[-0.006em]"><%= card[:title] %></span>
          <span class="text-sm text-muted-foreground group-hover:text-accent-foreground"><%= card[:description] %></span>
          <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-medium">
            <%= card[:cta] %>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
