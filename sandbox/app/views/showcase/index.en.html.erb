<% content_for :title, "Shadwire — shadcn/ui components for Ruby on Rails" %>
<% content_for :description do %>
  Shadwire brings shadcn/ui's Open Code model to Ruby on Rails: open, copyable
  ViewComponent source that your app installs and then owns, with no runtime gem.
<% end %>
<% content_for :head do %>
  <%= tag.style rouge_stylesheet %>
<% end %>

<%# 1. Hero %>
<section class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:py-28">
    <%= ui_badge(variant: :secondary, class: "mb-6") do %>
      <%= ui_icon("sparkles", size: :sm) %>v<%= registry_version %> · Rails + ViewComponent
    <% end %>
    <h1 class="mx-auto max-w-4xl text-balance text-5xl font-bold tracking-[-0.01em] leading-[0.92] sm:text-6xl lg:text-7xl">
      shadcn/ui components that become <span class="text-primary">your code</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-balance text-xl leading-[1.2] tracking-[-0.006em] text-muted-foreground sm:text-2xl">
      Shadwire brings shadcn/ui's <strong class="font-medium text-foreground">Open Code</strong> model
      to Ruby on Rails: open, copyable ViewComponent source that your app installs
      and then owns — with no runtime gem.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <%= ui_button(tag: :a, href: docs_path, size: :lg) do %>
        Get started<%= ui_icon("arrow-right", size: :sm) %>
      <% end %>
      <%= ui_button(tag: :a, href: components_path, variant: :outline, size: :lg) do %>
        Browse components
      <% end %>
      <%= ui_button(tag: :a, href: "https://github.com/edumoraes/shadwire", target: "_blank", rel: "noopener", variant: :ghost, size: :lg) do %>
        <%= ui_icon("github", size: :sm) %>GitHub
      <% end %>
    </div>
  </div>
</section>

<%# 2. Built on (social proof / stack) %>
<section class="border-b border-border/60 bg-muted/30">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <p class="text-center text-sm font-medium uppercase tracking-wide text-muted-foreground">
      Built on
    </p>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <% [
        "Ruby on Rails 8.1",
        "ViewComponent 4",
        "Tailwind CSS v4",
        "shadcn/ui",
        "Lucide",
        "Stimulus · Turbo"
      ].each do |label| %>
        <li>
          <span class="inline-flex items-center rounded-full border bg-card px-4 py-1.5 text-sm font-medium text-card-foreground shadow-xs">
            <%= label %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%# 3. Everything you need (showcase with preview + code) %>
<section class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95] sm:text-5xl">Everything you need</h2>
      <p class="mt-4 text-lg leading-snug text-muted-foreground sm:text-xl">
        Accessible, copy-ready components — from buttons and forms to dialogs and
        sidebars. Here are a few of them running live, with the code beside them.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl">
      <%= ui_tabs(default_value: @showcase.first[:name], class: "w-full") do %>
        <%= ui_tabs_list(class: "mx-auto flex w-fit flex-wrap") do %>
          <% @showcase.each do |example| %>
            <%= ui_tabs_trigger(value: example[:name]) { example[:title] } %>
          <% end %>
        <% end %>
        <% @showcase.each do |example| %>
          <%= ui_tabs_content(value: example[:name]) do %>
            <%= render "components/example", **example %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# 4. The code is yours (philosophy / Open Code) %>
<section class="border-b border-border/60 bg-muted/30">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95] sm:text-5xl">The code is yours</h2>
      <p class="mt-4 text-lg leading-snug text-muted-foreground sm:text-xl">
        Shadwire is not a runtime gem. You install the component source into your
        app and maintain it from there, free to adapt it to whatever you are building.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      <% [
        { icon: "package-open", title: "You own it",
          description: "The files are copied into your project and run with no Shadwire dependency at all." },
        { icon: "accessibility", title: "Accessible by default",
          description: "ARIA semantics and APG patterns are built into every component." },
        { icon: "palette", title: "Semantic tokens",
          description: "Styled with shadcn tokens (bg-primary, text-muted-foreground…), dark mode included." }
      ].each do |principle| %>
        <%= ui_card(class: "h-full") do %>
          <%= ui_card_header do %>
            <%= ui_card_title(class: "flex items-center gap-2") do %>
              <%= ui_icon(principle[:icon], class: "text-primary") %><%= principle[:title] %>
            <% end %>
            <%= ui_card_description { principle[:description] } %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# 5. Start here (getting started) %>
<section>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-[-0.01em] leading-[0.95] sm:text-5xl">Start here</h2>
      <p class="mt-4 text-lg leading-snug text-muted-foreground sm:text-xl">
        Browse the catalog, look through the ready-made compositions, or follow the project on GitHub.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { icon: "book-open", title: "Documentation", description: "Installation, the CLI, the agent skill, theming, and the guides on composition, styling and forms.", cta: "Read the docs", path: docs_path, external: false },
        { icon: "blocks", title: "Components", description: "#{docs_component_items.size} documented components, each with live examples and an API reference.", cta: "Browse the catalog", path: components_path, external: false },
        { icon: "layout-dashboard", title: "Blocks", description: "Ready-made compositions built out of the components, like sidebar-01.", cta: "See the blocks", path: blocks_path, external: false },
        { icon: "github", title: "GitHub", description: "Read the source and the registry, and contribute to the project.", cta: "Open the repository", path: "https://github.com/edumoraes/shadwire", external: true }
      ].each do |card| %>
        <%= link_to card[:path],
              **(card[:external] ? { target: "_blank", rel: "noopener" } : {}),
              class: "group flex h-full flex-col gap-3 rounded-xl border bg-card p-6 text-card-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] focus-visible:outline-none" do %>
          <span class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <%= ui_icon(card[:icon], size: :lg) %>
          </span>
          <span class="text-lg font-bold tracking-[-0.01em]"><%= card[:title] %></span>
          <span class="text-sm text-muted-foreground group-hover:text-accent-foreground"><%= card[:description] %></span>
          <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-medium">
            <%= card[:cta] %>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
