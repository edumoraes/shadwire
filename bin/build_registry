#!/usr/bin/env ruby
# frozen_string_literal: true

# Transforms registry/registry.json (the source of truth, with source->target
# file entries) into the *published* registry consumed by the CLI over HTTP.
# For each item it writes build/r/{name}.json with each file's content inlined
# (no source paths), plus build/r/index.json carrying a catalog and the shared
# `base` install used by `init`. Output goes to $BUILD_DIR (default build/).
#
# Mirrors bin/sync_registry conventions (Pathname, JSON, frozen string literal).

require "fileutils"
require "json"
require "pathname"
require_relative "../lib/shadwire_registry/api_extractor"
require_relative "../lib/shadwire_registry/llms_writer"

ROOT = Pathname.new(__dir__).join("..").expand_path
REGISTRY = JSON.parse(ROOT.join("registry/registry.json").read)
OUTPUT_DIR = Pathname.new(ENV.fetch("BUILD_DIR", ROOT.join("build").to_s)).join("r")

# Shared install bundled into every item; published separately as `base` so the
# CLI's `init` can lay it down once before adding components.
BASE_FILES = [
  { "source" => "registry/rails/ui/components/ui_component.rb", "target" => "app/components/ui_component.rb" },
  { "source" => "registry/rails/ui/styles/shadwire.css", "target" => "vendor/shadwire/shadwire.css" }
].freeze

# Prose an AST cannot infer, and the agent-facing discovery surface. Required
# rather than defaulted: a humanized fallback used to publish
# description == title == name, which made search useless.
REQUIRED_PROSE = %w[title description whenToUse].freeze

def validate_prose!(items)
  items.each do |item|
    missing = REQUIRED_PROSE.reject { |key| item[key].to_s.strip != "" }
    next if missing.empty?

    raise "Registry item #{item.fetch("name")} is missing required prose: #{missing.join(", ")}"
  end
end

# Component class => ui_* helper name, read from the per-item helper modules so
# the published API can name the helper that wraps each component.
def helper_index(root)
  Dir[root.join("registry/rails/ui/helpers/ui/*.rb")].each_with_object({}) do |file, index|
    # Each helper renders exactly one component, so pair the helper name with the
    # first Ui::*Component constant that follows it. Indentation-independent on
    # purpose: these modules nest one level deeper than the old flat helper.
    File.read(file).scan(/def (ui_\w+)[\s\S]*?(Ui::[A-Za-z0-9:]*Component)/).each do |helper, klass|
      index[klass] ||= helper
    end
  end
end

HELPERS = helper_index(ROOT).freeze

# An item's root component is the one named after the item itself; everything
# else it ships is a subcomponent used for composition.
def root_component?(item, target)
  snake = item.fetch("name").tr("-", "_")
  target == "app/components/ui/#{snake}_component.rb"
end

# "helper" is null when a component is not exposed through a ui_* wrapper: the
# shared UiComponent base, internal parts a parent renders itself (ScrollArea's
# viewport/thumb/corner), and block components, which are rendered directly.
def build_api(item)
  # Components may ship an .html.erb template alongside the class; only the Ruby
  # file carries the API.
  components = item.fetch("files")
                   .select { |file| file.fetch("target").start_with?("app/components/ui/") }
                   .select { |file| file.fetch("target").end_with?(".rb") }
                   .map do |file|
    source = ROOT.join(file.fetch("source"))
    api = ShadwireRegistry::ApiExtractor.call(source: source.read, path: file.fetch("source"))
    api.merge(
      "helper" => HELPERS[api["class"]],
      "root" => root_component?(item, file.fetch("target"))
    )
  end

  { "components" => components }
end

# Classify a file by its install target so the CLI knows where it belongs.
def file_type(target)
  case target
  when %r{\Aapp/components/} then "component"
  when %r{\Aapp/helpers/} then "helper"
  when %r{\Aapp/javascript/} then "javascript"
  when %r{\Avendor/} then "css"
  else "file"
  end
end

# Inline a source->target file entry into the published {target, content, type} shape.
def inline_file(file)
  source = ROOT.join(file.fetch("source"))
  raise "Missing registry source: #{file.fetch("source")}" unless source.file?

  {
    "target" => file.fetch("target"),
    "type" => file_type(file.fetch("target")),
    "content" => source.read
  }
end

# Resolve an item's registryDependencies to their full transitive closure of
# item names (excluding the item itself), so the published data is internally
# consistent. Mirrors the walk in bin/sync_registry's expand_with_dependencies.
def transitive_dependencies(item, items_by_name)
  resolved = []
  seen = {}
  queue = Array(item["registryDependencies"]).dup

  until queue.empty?
    dep_name = queue.shift
    next if seen[dep_name]

    seen[dep_name] = true
    dep = items_by_name[dep_name]
    unless dep
      warn "Unknown registry dependency #{dep_name} (required by #{item.fetch("name")})"
      next
    end

    resolved << dep_name
    Array(dep["registryDependencies"]).each { |name| queue << name unless seen[name] }
  end

  resolved.sort
end

items = REGISTRY.fetch("items")
items_by_name = items.to_h { |item| [item.fetch("name"), item] }

validate_prose!(items)

FileUtils.mkdir_p(OUTPUT_DIR)

# Collected for llms.txt / llms-full.txt, which describe the same items in plain
# text for agents that never install the CLI.
published_items = []

items.each do |item|
  name = item.fetch("name")
  published = {
    "name" => name,
    "type" => item.fetch("type"),
    "title" => item.fetch("title"),
    "description" => item.fetch("description"),
    "whenToUse" => item.fetch("whenToUse"),
    "usage" => Array(item["usage"]),
    "gems" => Array(item["gems"]),
    "importmap" => Array(item["importmap"]),
    "registryDependencies" => transitive_dependencies(item, items_by_name),
    "requiresStimulus" => item.fetch("files").any? { |file| file.fetch("target").start_with?("app/javascript/") },
    "api" => build_api(item),
    "files" => item.fetch("files").map { |file| inline_file(file) }
  }

  OUTPUT_DIR.join("#{name}.json").write(JSON.pretty_generate(published) + "\n")
  published_items << published
end

index = {
  "name" => REGISTRY.fetch("name"),
  "version" => REGISTRY.fetch("version"),
  "items" => items.map do |item|
    name = item.fetch("name")
    {
      "name" => name,
      "type" => item.fetch("type"),
      "title" => item.fetch("title"),
      "description" => item.fetch("description"),
      "whenToUse" => item.fetch("whenToUse")
    }
  end,
  "base" => {
    "files" => BASE_FILES.map { |file| inline_file(file) },
    "gems" => Array(REGISTRY.fetch("gems")),
    "tailwind" => {
      "version" => REGISTRY.fetch("tailwind").fetch("version"),
      "css" => File.basename(REGISTRY.fetch("tailwind").fetch("css"))
    }
  }
}

OUTPUT_DIR.join("index.json").write(JSON.pretty_generate(index) + "\n")

OUTPUT_DIR.join("llms.txt").write(
  ShadwireRegistry::LlmsWriter.index(registry: REGISTRY, items: published_items)
)
OUTPUT_DIR.join("llms-full.txt").write(
  ShadwireRegistry::LlmsWriter.full(registry: REGISTRY, items: published_items)
)

puts "Built #{items.size} items + index + llms.txt into #{OUTPUT_DIR.relative_path_from(ROOT)}"
